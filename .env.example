# Pooled Neon URL is fine for the API. Migrations use the direct host automatically.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Long random string. Render needs this set as an environment variable.
JWT_SECRET=change-me

# Optional. Chromium opens /bill/{token} here when generating A4 PDFs.
# Defaults to https://app.petrozz.com — set only for local/staging (e.g. http://localhost:3000).
# FRONTEND_URL=

# Optional path to Chrome/Chromium if puppeteer's bundled browser is unavailable (e.g. some hosts).
# PUPPETEER_EXECUTABLE_PATH=

# S3-compatible storage (R2/MinIO/AWS) for uploads and cached bill PDFs.
# AWS_ENDPOINT_URL_S3=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-2
# S3_BUCKET=pettroz

# Optional 32-byte key encoded as 64 hex characters for Website Login encryption.
# By default, the backend derives a separate encryption key from JWT_SECRET.
# Keep JWT_SECRET stable or preserve this override; changing the active key makes saved passwords unreadable.
CONTACTS_ENCRYPTION_KEY=

# Used only when the database has no dealer yet.
SEED_OWNER_PHONE=9820011420
SEED_OWNER_PASSWORD=1142
SEED_OWNER_NAME=Karthik Murugan

# Created once, with no outlet. Signs in above every dealer.
SEED_SUPER_PHONE=7558118534
SEED_SUPER_PASSWORD=1234
SEED_SUPER_NAME=Super admin
