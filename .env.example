# Pooled Neon URL is fine for the API. Migrations use the direct host automatically.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Long random string. Render needs this set as an environment variable.
JWT_SECRET=change-me

# 32-byte encryption key encoded as 64 hex characters, required for Website Logins.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this key stable and backed up; changing it makes stored passwords unreadable.
CONTACTS_ENCRYPTION_KEY=

# Used only when the database has no dealer yet.
SEED_OWNER_PHONE=9820011420
SEED_OWNER_PASSWORD=1142
SEED_OWNER_NAME=Karthik Murugan

# Created once, with no outlet. Signs in above every dealer.
SEED_SUPER_PHONE=7558118534
SEED_SUPER_PASSWORD=1234
SEED_SUPER_NAME=Super admin
